   "source": "# TFC Parte 1: Función acumulada y su derivada",
   "id": "7f9a21c2ecaf894a"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": "import sympy as sp",
   "id": "a164152c12f88126",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "t, x = sp.symbols(\"t x\")\n",
    "f = t ** 2\n",
    "G = sp.integrate(f, (t, 0, x))\n",
    "print(f\"G:  {G}\")\n",
    "print(f\"G': {sp.diff(G, x)}\")\n",
    "print(f\"f:  {f}\")"
   ],
   "id": "2b52871dd6cbcc09",
   "outputs": [],
   "execution_count": null
  }
