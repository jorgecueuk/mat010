    "# Integrales cíclicas\n",
    "\n"
   ],
   "id": "f72aa48315fcf43b"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "from sympy import *\n",
    "print(\"Comporbación de integral ciclica\")\n",
    "x, a, b = symbols('x a b')\n",
    "f = exp(x) * sin(x)\n",
    "F = integrate(f, x)\n",
    "print(f\"f(x) : {f}\")\n",
    "print(f\"F(x) : {F}\")"
   ],
