   "source": [
    "from sympy import symbols, exp, integrate\n",
    "\n",
    "x, k = symbols('x k')\n",
    "F = k * x * exp(-x ** 2)\n",
    "W = integrate(F, (x, 0, 2))\n",
    "print(W.simplify())\n"
   ],
